# Copy to .env and fill in what you have. Everything is optional except SESSION_SECRET in production.
# server.py reads this file at start (python-dotenv).
PORT=3000
HOST=127.0.0.1
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres (Supabase) for accounts, companies and notes. Without it they are JSON files
# in DATA_DIR, which Vercel wipes. Use Supabase's "Transaction pooler" string (port 6543).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-long-password    # required in production

# Public address of the app, used in the links of account emails (email confirmation,
# password reset). Set it in production: otherwise links follow the request's Host header.
# APP_URL=https://prospect-hub.example.com

# With SMTP configured (or SMTP_MODE=json), new sign-ups must confirm their email before
# signing in, and "Forgot your password?" appears on the sign-in page. In dry-run mode the
# links are printed in the server console.
# SMTP_MODE=json   # dry-run: log messages instead of delivering them
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=

# AI (email drafts + the help assistant) is per person: each user pastes their own
# Google Gemini key on the Settings page. Nothing to set here; this only changes
# which model those keys are used with.
# GEMINI_MODEL=gemini-2.5-flash

# Google Places API (New): fills missing websites/phones. It does NOT return emails.
GOOGLE_PLACES_API_KEY=
